  "lanes": {
    "journal": {
      "label": "The Journal",
      "intent": "Editorial \u2014 blog, guide and explainer promotion. Restrained, type-led, warm.",
      "voice": "Considered, plain-spoken, feeling-first. Never urgency-led.",
      "designs": [
        "carousel-journal"
      ]
    },
    "studio": {
      "label": "The Studio",
      "intent": "Behind-the-scenes from the workshop. Documentary, single-beat, plate-led.",
      "voice": "Quiet, observational. Lets the room speak. AU English.",
      "designs": [
        "story-studio"
      ]
    },
    "promo": {
      "label": "Promo",
      "intent": "Genuine newness \u2014 a single product, a fresh delivery, a range refresh. Newness, not push.",
      "voice": "Plain-spoken about what just arrived. Never urgency-led. No countdown, no discount framing.",
      "designs": [
        "story-promo"
      ]
    },
    "gift": {
      "label": "Gift",
      "intent": "The act of giving and the moment received. Two-beat Story \u2014 the preparation, the arrival.",
      "voice": "Warm, ceremonial without being formal. The gift is the gesture, not the price.",
      "designs": [
        "story-gift"
      ]
    }
  },
  "designs": {
    "carousel-journal": {
      "lane": "journal",
      "label": "Journal Carousel",
      "format": "carousel",
      "primaryRatio": "4:5",
      "ratios": [
        "4:5",
        "1:1",
        "9:16"
      ],
      "bestFor": [
        "blog_promo",
        "editorial_guide",
        "occasion_explainer"
      ],
      "avoidFor": [
        "product_drop",
        "urgency_offer",
        "flash_sale"
      ],
      "requiresPlate": true,
      "recommendedSequence": [
        "cover",
        "intro",
        "interior",
        "interior",
        "closing"
      ],
      "slides": {
        "cover": {
          "template": "cover.html",
          "photo": "required",
          "role": "opener",
          "levers": {
            "theme": [
              "light",
              "dark"
            ]
          }
        },
        "intro": {
          "template": "intro.html",
          "photo": "optional",
          "role": "lede"
        },
        "interior": {
          "template": "interior.html",
          "photo": "none",
          "role": "body",
          "repeatable": true
        },
        "closing": {
          "template": "closing.html",
          "photo": "required",
          "role": "closer"
        }
      }
    },
    "story-studio": {
