{
  "brand": "fig-and-bloom",
  "version": "3.0.0",
  "system": "Lust + Cervanttis + Neuzeit Grotesk on white / ink / tan-1 #F0E5D0 / tan-2 #B89A75. v3 adds the seed lanes (from the 2023 PSD kit, reconciled to this palette) and asset-library photo queries. See design-system/SYSTEM.md.",
  "ratios": {
    "4:5": {
      "w": 1080,
      "h": 1350,
      "label": "Feed (portrait)",
      "safeTop": 108,
      "safeBottom": 108
    },
    "1:1": {
      "w": 1080,
      "h": 1080,
      "label": "Feed (square)",
      "safeTop": 86,
      "safeBottom": 86
    },
    "9:16": {
      "w": 1080,
      "h": 1920,
      "label": "Story / Reel",
      "safeTop": 269,
      "safeBottom": 384
    },
    "1.91:1": {
      "w": 1200,
      "h": 630,
      "label": "Landscape / link card",
      "safeTop": 0,
      "safeBottom": 0
    }
  },
  "lanes": {
    "journal": {
      "label": "The Journal",
      "intent": "Editorial \u2014 blog, guide and explainer promotion. Restrained, type-led, warm.",
      "voice": "Considered, plain-spoken, feeling-first. Never urgency-led.",
      "designs": [
        "carousel-journal"
      ]
    },
    "studio": {
      "label": "The Studio",
      "intent": "Behind-the-scenes from the workshop. Documentary, single-beat, plate-led.",
      "voice": "Quiet, observational. Lets the room speak. AU English.",
      "designs": [
        "story-studio"
      ]
    },
    "promo": {
      "label": "Promo",
      "intent": "Genuine newness \u2014 a single product, a fresh delivery, a range refresh. Newness, not push.",
      "voice": "Plain-spoken about what just arrived. Never urgency-led. No countdown, no discount framing.",
      "designs": [
        "story-promo"
      ]
    },
    "gift": {
      "label": "Gift",
      "intent": "The act of giving and the moment received. Two-beat Story \u2014 the preparation, the arrival.",
      "voice": "Warm, ceremonial without being formal. The gift is the gesture, not the price.",
      "designs": [
        "story-gift"
      ]
    },
    "editorial": {
      "label": "Editorial",
      "intent": "Manifesto, value-statement, dark-plate pull-quote. One editorial line, no CTA.",
      "voice": "Fig & Bloom voice \u2014 calm, feeling-first, AU English. A single line worth standing behind.",
      "designs": [
        "story-editorial"
      ]
    },
    "quote-soft": {
      "label": "Quote / soft",
      "intent": "A poetic statement on a quiet scene. Tan-1 left rail, soft-focus photo on the right.",
      "voice": "A short statement, not a paragraph. The rail speaks; the photo listens.",
      "designs": [
        "story-quote-soft"
      ]
    },
    "tagline": {
      "label": "Tagline",
      "intent": "A single sans-only label on a dark plate. A micro-format, not a statement.",
      "voice": "A tag, not a manifesto. Sans only \u2014 no Cervanttis on this lane.",
      "designs": [
        "story-tagline"
      ]
    },
    "overlay": {
      "label": "Overlay",
      "intent": "One large translucent word over a hand-held or in-stillness plate. A moment, not a message.",
      "voice": "One word. If you need a sentence, use story-editorial.",
      "designs": [
        "story-overlay"
      ]
    },
    "caption": {
      "label": "Caption card",
      "intent": "A single photograph presented like a print on a split field, named in script beneath. Seed: Design 1.",
      "voice": "A handwritten label, lowercase, affectionate. Name the bunch, the moment, the person.",
      "designs": [
        "card-caption"
      ]
    },
    "statement": {
      "label": "Statement",
      "intent": "Stacked display caps beside or across a photograph. The loud-but-considered lane. Seeds: Designs 2 & 7.",
      "voice": "Short declarative lines, broken deliberately. Wit welcome; urgency never.",
      "designs": [
        "card-statement-bars",
        "card-statement-split"
      ]
    },
    "testimonial": {
      "label": "Testimonial",
      "intent": "A customer's words on a white card over an ink field with line-art florals. Seed: Design 3.",
      "voice": "Their words, verbatim, lightly trimmed. First name + initial attribution.",
      "designs": [
        "card-testimonial"
      ]
    },
    "quote-lineart": {
      "label": "Quote / line-art",
      "intent": "A borrowed or brand line centred on a line-art floral field, light or dark. Seed: Designs 4 & 5.",
      "voice": "A line worth keeping. Cervanttis attribution beneath, its own block.",
      "designs": [
        "card-quote-lineart"
      ]
    },
    "script-moment": {
      "label": "Script moment",
      "intent": "One Cervanttis line on a flat field or quiet plate. The softest beat in the feed. Seed: Design 6.",
      "voice": "Two or three words, lowercase. If it needs a sentence, use quote-lineart.",
      "designs": [
        "card-script-moment"
      ]
    },
    "note": {
      "label": "Studio note",
      "intent": "A small announcement on textured paper with a line-art bloom — hiring, opening hours, a thank-you. Seed: Design 8.",
      "voice": "A note pinned to the studio door. Lowercase script, no chrome.",
      "designs": [
        "card-note"
      ]
    }
  },
  "designs": {
    "carousel-journal": {
      "lane": "journal",
      "label": "Journal Carousel",
      "format": "carousel",
      "primaryRatio": "4:5",
      "ratios": ["4:5", "1:1", "9:16"],
      "bestFor": ["blog_promo", "editorial_guide", "occasion_explainer"],
      "avoidFor": ["product_drop", "urgency_offer", "flash_sale"],
      "requiresPlate": true,
      "recommendedSequence": ["cover", "intro", "interior", "interior", "closing"],
      "slides": {
        "cover":   { "template": "cover.html",   "photo": "required", "role": "opener",       "levers": { "theme": ["light", "dark"] } },
        "intro":   { "template": "intro.html",   "photo": "optional", "role": "lede" },
        "interior":{ "template": "interior.html","photo": "none",     "role": "body",         "repeatable": true },
        "closing": { "template": "closing.html", "photo": "required", "role": "closer" }
      }
    },
    "story-studio": {
      "lane": "studio",
      "label": "Story Studio",
      "format": "story",
      "primaryRatio": "9:16",
      "ratios": ["9:16", "4:5", "1:1"],
      "bestFor": ["behind_the_scenes", "studio_moment", "process_vignette"],
      "avoidFor": ["product_drop", "multi_beat", "urgency_offer"],
      "requiresPlate": true,
      "recommendedSequence": ["cover"],
      "slides": {
        "cover": { "template": "cover.html", "photo": "required", "role": "studio_moment", "levers": { "theme": ["light", "dark"] } }
      }
    },
    "story-promo": {
      "lane": "promo",
      "label": "Story Promo",
      "format": "story",
      "primaryRatio": "9:16",
      "ratios": ["9:16", "4:5", "1:1"],
      "bestFor": ["product_announcement", "new_in", "range_refresh", "fresh_studio_delivery"],
      "avoidFor": ["flash_sale", "urgency_offer", "countdown", "discount_framing"],
      "requiresPlate": true,
      "recommendedSequence": ["cover"],
      "slides": {
        "cover": { "template": "cover.html", "photo": "required", "role": "product_announcement", "levers": { "theme": ["light", "dark"] } }
      }
    },
    "story-gift": {
      "lane": "gift",
      "label": "Story Gift",
      "format": "story",
      "primaryRatio": "9:16",
      "ratios": ["9:16", "4:5", "1:1"],
      "bestFor": ["gifting_moment", "corporate_gifting", "the_act_of_giving"],
      "avoidFor": ["flash_sale", "urgency_offer", "discount_framing", "single_beat_announcement"],
      "requiresPlate": true,
      "recommendedSequence": ["intro", "closing"],
      "slides": {
        "intro":   { "template": "intro.html",   "photo": "required", "role": "scene_setter",     "levers": { "theme": ["light", "dark"] } },
        "closing": { "template": "closing.html", "photo": "required", "role": "moment_received",  "levers": { "theme": ["light", "dark"] } }
      }
    },
    "story-editorial": {
      "lane": "editorial",
      "label": "Story Editorial",
      "format": "story",
      "primaryRatio": "9:16",
      "ratios": ["9:16", "4:5", "1:1"],
      "bestFor": ["manifesto", "value_statement", "pull_quote", "journal_line"],
      "avoidFor": ["product_drop", "multi_beat", "needs_cta"],
      "requiresPlate": true,
      "recommendedSequence": ["cover"],
      "slides": {
        "cover": { "template": "cover.html", "photo": "required", "role": "manifesto", "levers": { "theme": ["light", "dark"] } }
      }
    },
    "story-quote-soft": {
      "lane": "quote-soft",
      "label": "Story Quote-Soft",
      "format": "story",
      "primaryRatio": "9:16",
      "ratios": ["9:16", "4:5", "1:1"],
      "bestFor": ["poetic_statement", "host_moment", "journal_line_soft"],
      "avoidFor": ["product_drop", "hard_announcement", "needs_manifesto"],
      "requiresPlate": true,
      "recommendedSequence": ["cover"],
      "slides": {
        "cover": { "template": "cover.html", "photo": "required", "role": "quiet_statement" }
      }
    },
    "story-tagline": {
      "lane": "tagline",
      "label": "Story Tagline",
      "format": "story",
      "primaryRatio": "9:16",
      "ratios": ["9:16", "4:5", "1:1"],
      "bestFor": ["gift_edit", "studio_notes", "for_the_host", "label_only"],
      "avoidFor": ["needs_serif", "long_statement", "manifesto"],
      "requiresPlate": true,
      "recommendedSequence": ["cover"],
      "slides": {
        "cover": { "template": "cover.html", "photo": "required", "role": "label" }
      }
    },
    "story-overlay": {
      "lane": "overlay",
      "label": "Story Overlay",
      "format": "story",
      "primaryRatio": "9:16",
      "ratios": ["9:16", "4:5", "1:1"],
      "bestFor": ["one_word_moment", "translucent_emphasis", "micro_moment"],
      "avoidFor": ["needs_sentence", "product_drop", "giveaway"],
      "requiresPlate": true,
      "recommendedSequence": ["cover"],
      "slides": {
        "cover": { "template": "cover.html", "photo": "required", "role": "one_word_moment" }
      }
    },
    "card-caption": {
      "lane": "caption",
      "label": "Caption Card",
      "format": "static",
      "primaryRatio": "1:1",
      "ratios": ["1:1", "4:5", "9:16", "1.91:1"],
      "bestFor": ["named_bunch", "weekly_favourite", "customer_moment", "print_style_share"],
      "avoidFor": ["needs_body_copy", "urgency_offer", "multi_beat"],
      "requiresPlate": true,
      "recommendedSequence": ["cover"],
      "slides": {
        "cover": { "template": "cover.html", "photo": "required", "role": "print_with_label" }
      }
    },
    "card-statement-bars": {
      "lane": "statement",
      "label": "Statement Bars",
      "format": "static",
      "primaryRatio": "1:1",
      "ratios": ["1:1", "4:5", "9:16", "1.91:1"],
      "bestFor": ["bold_declaration", "campaign_line", "wit_moment"],
      "avoidFor": ["long_copy", "soft_poetic_line", "discount_framing"],
      "requiresPlate": true,
      "recommendedSequence": ["cover"],
      "slides": {
        "cover": { "template": "cover.html", "photo": "required", "role": "declaration_over_plate" }
      }
    },
    "card-statement-split": {
      "lane": "statement",
      "label": "Statement Split",
      "format": "static",
      "primaryRatio": "1:1",
      "ratios": ["1:1", "4:5", "9:16", "1.91:1"],
      "bestFor": ["editorial_quote", "campaign_line", "press_pull"],
      "avoidFor": ["long_copy", "urgency_offer"],
      "requiresPlate": true,
      "recommendedSequence": ["cover"],
      "slides": {
        "cover": { "template": "cover.html", "photo": "required", "role": "stacked_caps_beside_plate" }
      }
    },
    "card-testimonial": {
      "lane": "testimonial",
      "label": "Testimonial Card",
      "format": "static",
      "primaryRatio": "1:1",
      "ratios": ["1:1", "4:5", "9:16", "1.91:1"],
      "bestFor": ["customer_review", "social_proof", "press_quote"],
      "avoidFor": ["product_drop", "needs_photo", "long_review"],
      "requiresPlate": false,
      "recommendedSequence": ["cover"],
      "slides": {
        "cover": { "template": "cover.html", "photo": "none", "role": "review_card" }
      }
    },
    "card-quote-lineart": {
      "lane": "quote-lineart",
      "label": "Quote Line-art",
      "format": "static",
      "primaryRatio": "1:1",
      "ratios": ["1:1", "4:5", "9:16", "1.91:1"],
      "bestFor": ["borrowed_quote", "brand_line", "seasonal_sentiment"],
      "avoidFor": ["product_drop", "needs_photo", "cta_needed"],
      "requiresPlate": false,
      "recommendedSequence": ["cover"],
      "slides": {
        "cover": { "template": "cover.html", "photo": "none", "role": "quote_on_lineart", "levers": { "theme": ["light", "dark"] } }
      }
    },
    "card-script-moment": {
      "lane": "script-moment",
      "label": "Script Moment",
      "format": "static",
      "primaryRatio": "1:1",
      "ratios": ["1:1", "4:5", "9:16", "1.91:1"],
      "bestFor": ["micro_sentiment", "occasion_beat", "feed_breather"],
      "avoidFor": ["needs_sentence", "product_drop", "cta_needed"],
      "requiresPlate": false,
      "recommendedSequence": ["cover"],
      "slides": {
        "cover": { "template": "cover.html", "photo": "optional", "role": "script_line", "levers": { "surface": ["tan-1", "tan-2", "ink", "photo"] } }
      }
    },
    "card-note": {
      "lane": "note",
      "label": "Studio Note",
      "format": "static",
      "primaryRatio": "1:1",
      "ratios": ["1:1", "4:5", "9:16", "1.91:1"],
      "bestFor": ["hiring", "hours_change", "small_announcement", "thank_you"],
      "avoidFor": ["product_drop", "long_copy", "urgency_offer"],
      "requiresPlate": false,
      "recommendedSequence": ["cover"],
      "slides": {
        "cover": { "template": "cover.html", "photo": "none", "role": "paper_note" }
      }
    }
  }
}
