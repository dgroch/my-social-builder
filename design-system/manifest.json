{
  "brand": "fig-and-bloom",
  "version": "1.1.0",
  "ratios": {
    "4:5": {
      "w": 1080,
      "h": 1350,
      "label": "Feed (portrait)",
      "safeTop": 108,
      "safeBottom": 108
    },
    "1:1": {
      "w": 1080,
      "h": 1080,
      "label": "Feed (square)",
      "safeTop": 86,
      "safeBottom": 86
    },
    "9:16": {
      "w": 1080,
      "h": 1920,
      "label": "Story / Reel",
      "safeTop": 269,
      "safeBottom": 384
